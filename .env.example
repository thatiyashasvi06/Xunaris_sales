# ==============================================================================
# Xunaris & HYRA Connect CRM — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_xunaris_2026_change_in_production

# SQLite Database Storage Location
DB_PATH=./data/xunaris_crm.sqlite

# Google Gemini AI Engine Key (Optional for AI Lead Qualification)
GEMINI_API_KEY=

# ==============================================================================
# Email Campaign Live Delivery Configuration (SMTP)
# ==============================================================================
# OPTION 1: Free Gmail Setup (Recommended for immediate testing with sister/colleagues)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create an app password named "Xunaris CRM" (generates 16 letters)
# 4. Fill below:
GMAIL_USER=
GMAIL_APP_PASS=

# OPTION 2: Custom Enterprise SMTP (SendGrid, Brevo, AWS SES, Mailgun, Corporate SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Xunaris Sales <sales@xunaris.com>"
SMTP_FROM="Xunaris Info <info@xunaris.com>"
SMTP_FROM_NAME="Xunaris Sales"
